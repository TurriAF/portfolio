---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Mensaje enviado">
  <div style="min-height:100vh; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:1rem; text-align:center; padding:2rem;">
    <div style="font-size:3rem;">✅</div>
    <h1 style="color:#00c8ff; font-size:1.5rem;">Mensaje enviado</h1>
    <p style="color:#7a8599;">Gracias por contactar. Te responderé lo antes posible.</p>
    <a href="/" style="margin-top:1rem; color:#00c8ff; font-family:monospace; font-size:0.85rem; border:1px solid rgba(0,200,255,0.3); padding:0.6rem 1.5rem; border-radius:4px; text-decoration:none;">
      ← Volver al portfolio
    </a>
  </div>
</Layout>