---
import { personal } from '../data/portfolio';
---
<section id="contacto" class="py-24 px-10 max-w-4xl mx-auto">
  <div class="flex items-center gap-4 mb-12 fade-up">
    <span class="mono text-[0.75rem] text-cyan-400">05</span>
    <h2 class="text-[1.7rem] font-semibold tracking-tight">Contacto</h2>
    <span class="flex-1 h-px bg-cyan-500/12"></span>
  </div>

  <div class="grid grid-cols-[1fr_280px] gap-12 items-start fade-up">

    <!-- Formulario Netlify Forms -->
    <form
      name="contacto"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
      class="space-y-4"
    >
      <!-- Campo anti-spam oculto -->
      <input type="hidden" name="form-name" value="contacto" />
      <p class="hidden"><input name="bot-field" /></p>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="mono text-[0.7rem] uppercase tracking-widest text-cyan-400 block mb-1.5">Nombre</label>
          <input
            type="text"
            name="nombre"
            required
            placeholder="Tu nombre"
            class="w-full bg-[#151b2e] border border-cyan-500/12 rounded px-4 py-2.5 text-sm text-slate-200 placeholder-slate-600 focus:outline-none focus:border-cyan-400/60 transition-colors duration-200 mono"
          />
        </div>
        <div>
          <label class="mono text-[0.7rem] uppercase tracking-widest text-cyan-400 block mb-1.5">Correo</label>
          <input
            type="email"
            name="correo"
            required
            placeholder="tu@email.com"
            class="w-full bg-[#151b2e] border border-cyan-500/12 rounded px-4 py-2.5 text-sm text-slate-200 placeholder-slate-600 focus:outline-none focus:border-cyan-400/60 transition-colors duration-200 mono"
          />
        </div>
      </div>

      <div>
        <label class="mono text-[0.7rem] uppercase tracking-widest text-cyan-400 block mb-1.5">Asunto</label>
        <input
          type="text"
          name="asunto"
          required
          placeholder="¿De qué se trata?"
          class="w-full bg-[#151b2e] border border-cyan-500/12 rounded px-4 py-2.5 text-sm text-slate-200 placeholder-slate-600 focus:outline-none focus:border-cyan-400/60 transition-colors duration-200 mono"
        />
      </div>

      <div>
        <label class="mono text-[0.7rem] uppercase tracking-widest text-cyan-400 block mb-1.5">Mensaje</label>
        <textarea
          name="mensaje"
          required
          rows="5"
          placeholder="Cuéntame..."
          class="w-full bg-[#151b2e] border border-cyan-500/12 rounded px-4 py-2.5 text-sm text-slate-200 placeholder-slate-600 focus:outline-none focus:border-cyan-400/60 transition-colors duration-200 mono resize-none"
        ></textarea>
      </div>

      <button
        type="submit"
        class="mono text-[0.8rem] uppercase tracking-widest px-7 py-3 rounded bg-cyan-400 text-[#0a0e17] font-semibold border border-cyan-400 hover:bg-transparent hover:text-cyan-400 transition-all duration-200 w-full"
      >
        Enviar mensaje
      </button>
    </form>

    <!-- Panel lateral con info -->
    <div class="space-y-6 pt-1">
      <div>
        <div class="mono text-[0.7rem] uppercase tracking-widest text-cyan-400 mb-1.5">¿Prefieres el email directo?</div>
        <a href={`mailto:${personal.email}`} class="text-sm text-slate-300 hover:text-cyan-400 transition-colors duration-200">
          {personal.email}
        </a>
      </div>

      <div>
        <div class="mono text-[0.7rem] uppercase tracking-widest text-cyan-400 mb-3">Encuéntrame en</div>
        <div class="flex gap-3">
          <!-- GitHub -->
          <a
            href={personal.github}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
            class="w-10 h-10 rounded-full border border-cyan-500/20 flex items-center justify-center text-slate-400 hover:text-cyan-400 hover:border-cyan-400 transition-all duration-200"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.009-.868-.013-1.703-2.782.605-3.369-1.342-3.369-1.342-.454-1.155-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0 1 12 6.836a9.59 9.59 0 0 1 2.504.337c1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.202 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z"/>
            </svg>
          </a>
          <!-- LinkedIn -->
          <a
            href={personal.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="w-10 h-10 rounded-full border border-cyan-500/20 flex items-center justify-center text-slate-400 hover:text-cyan-400 hover:border-cyan-400 transition-all duration-200"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
        </div>
      </div>
      
    </div>
  </div>
</section>

<footer class="text-center py-8 mono text-[0.72rem] text-slate-600 border-t border-cyan-500/10">
  Diseñado y creado por <span class="text-cyan-400">{personal.name}</span> · 2026
</footer>