---
import '../styles/global.css';
interface Props {
  title?: string;
}
const { title = "David Aguilar Fernández — Frontend Developer" } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Portfolio de David Aguilar Fernández, desarrollador frontend basado en Almería." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <style>
      html { scroll-behavior: smooth; }
      body { font-family: 'Inter', sans-serif; }
      .mono { font-family: 'JetBrains Mono', monospace; }
      @media (prefers-reduced-motion: reduce) {
        .fade-up { opacity: 1 !important; transform: none !important; transition: none !important; }
      }
    </style>
  </head>
  <body class="bg-[#0a0e17] text-slate-200 overflow-x-hidden">
    <slot />
  </body>
</html>
