---
import { skills } from '../data/portfolio';
import { Icon } from '@iconify/react';
---
<section id="habilidades" class="py-24 px-10 max-w-4xl mx-auto">
  <div class="flex items-center gap-4 mb-12 fade-up">
    <span class="mono text-[0.75rem] text-cyan-400">02</span>
    <h2 class="text-[1.7rem] font-semibold tracking-tight">Habilidades</h2>
    <span class="flex-1 h-px bg-cyan-500/12"></span>
  </div>

  <div class="grid grid-cols-[repeat(auto-fit,minmax(190px,1fr))] gap-4 fade-up">
    {skills.map(group => (
      <div class="bg-[#151b2e] border border-cyan-500/12 rounded-lg p-5 hover:border-cyan-400/35 transition-colors duration-200">
        <div class="mono text-[0.7rem] uppercase tracking-widest text-cyan-400 mb-4">{group.category}</div>
        <div class="flex flex-wrap gap-3">
          {group.items.map(item => (
            <div class="flex flex-col items-center gap-1.5 group/skill">
              <div class="w-10 h-10 rounded-lg bg-[#0a0e17] border border-cyan-500/10 flex items-center justify-center group-hover/skill:border-cyan-400/40 transition-colors duration-200">
                <Icon client:load icon={item.icon} width="24" height="24" />
              </div>
              <span class="mono text-[0.65rem] text-slate-500 group-hover/skill:text-slate-300 transition-colors duration-200 text-center leading-tight">
                {item.name}
              </span>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>